# GEMINI_API_KEY: Required for Gemini AI API calls (BACKEND ONLY - never expose to frontend).
# Configure this in your Node backend host environment variables or AI Studio Secrets.
GEMINI_API_KEY=

# ALLOWED_ORIGIN: Optional extra frontend origin(s) allowed by CORS (comma-separated).
# https://sameedkhan1434-tech.github.io is already allowed by default.
ALLOWED_ORIGIN=

# VITE_API_URL: Public URL of your deployed BUGGY AI backend (FRONTEND BUILD TIME ONLY).
# Example: https://buggy-ai-backend.onrender.com (leave empty when serving frontend + backend together)
VITE_API_URL=

# APP_URL: The URL where this applet is hosted.
APP_URL=
